rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public search app: write-only, aggregate demand events. No patient identity is ever
    // stored here (no name, phone, email, or device id) — just a cancer type, a coarse
    // location label, and search facets. Never readable by the public app.
    match /demandLog/{eventId} {
      allow create: if isValidDemandEvent(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Owner/commercial-entity allowlist: one doc per authorised Firebase Auth UID.
    // Managed manually via the Firebase console — never written by the app itself.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Public search app: write-only, aggregate usage events (searches, browses, location
    // changes, clicks). Same no-patient-identity guardrail as demandLog — never readable
    // by the public app, only by admins for the usage-activity dashboard.
    match /usageEvents/{eventId} {
      allow create: if isValidUsageEvent(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Optional public accounts: a signed-in user may only ever read/write their own
    // favorites subcollection. No other user, and no admin, can read another person's
    // saved trials — favorites are personal, not part of the aggregate demand signal.
    match /users/{uid}/favorites/{trialKey} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Doctor / trial-coordinator provider portal (/portal). A user always reads/creates/
    // updates their own profile; admins can read and update all profiles for verification;
    // a doctor may additionally read (and approve/reject) coordinator profiles that named their email.
    match /users/{uid} {
      allow read: if resource.data.role == 'doctor' || (request.auth != null && (
        request.auth.uid == uid ||
        isAdmin() ||
        (resource.data.role == 'coordinator' && resource.data.requestedDoctorEmail == request.auth.token.email)
      ));
      allow create: if request.auth != null && (isValidProfileCreate(uid, request.resource.data) || isAdmin());
      allow update: if isAdmin() || isSelfProfileUpdate(uid, request.resource.data) || isDoctorApproval(request.resource.data) ||
        isSameHospitalPiAuthorization(request.resource.data);
      allow delete: if isAdmin();
    }

    // Trials submitted by an approved coordinator or doctor, in the same TrialSite shape
    match /submittedTrials/{id} {
      allow read: if true;
      allow create: if (isApprovedCoordinator() || isApprovedDoctor() || isAdmin()) &&
        request.resource.data.submittedBy == request.auth.uid &&
        request.resource.data.nctId == id &&
        request.resource.data.listingStatus == 'published';
      allow update: if (request.auth != null && resource.data.submittedBy == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // Registry trials (ClinicalTrials.gov + CTRI), one doc per study. Public catalogue data;
    // written only by scripts/seed-registry.ts via the Admin SDK, which bypasses these rules.
    match /registryTrials/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Trial claims by Principal Investigators and site coordinators at their hospital center.
    // Publicly readable so verified investigator contact info is shown on public trial search.
    match /trialClaims/{claimId} {
      allow read: if true;
      allow create: if (isApprovedDoctor() || isApprovedCoordinator() || isAdmin()) &&
        request.resource.data.claimedByUid == request.auth.uid;
      allow update: if (request.auth != null && resource.data.claimedByUid == request.auth.uid) || isAdmin();
      allow delete: if (request.auth != null && resource.data.claimedByUid == request.auth.uid) || isAdmin();
    }

    // Owner-only store for a claim's contact phone/email that the PI chose to keep personal
    // rather than publish. Never readable by the public app or other providers.
    match /claimPrivateContacts/{claimId} {
      allow read, delete: if isAdmin() || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow create, update: if isAdmin() || (
        request.auth != null &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.claimId == claimId &&
        (resource == null || resource.data.ownerUid == request.auth.uid) &&
        get(/databases/$(database)/documents/trialClaims/$(claimId)).data.claimedByUid == request.auth.uid);
    }

    // Account phone numbers — kept out of users/{uid} because PI profiles are publicly readable.
    match /userContacts/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == uid &&
        (request.resource == null || request.resource.data.uid == uid));
    }

    // Closed-trial repository, one doc per claimed site (doc id == claim id). Publicly readable so
    // every active list can hide closed sites. Only an approved Principal Investigator may close a
    // trial — and only one claimed by them, by a coordinator they approved, or at their hospital.
    match /closedTrials/{claimId} {
      allow read: if true;
      allow create: if isApprovedDoctor() &&
        request.resource.data.closedByUid == request.auth.uid &&
        request.resource.data.claimId == claimId &&
        piMayCloseClaim(claimId);
      allow update: if false;
      allow delete: if isAdmin() || (isApprovedDoctor() && resource.data.closedByUid == request.auth.uid);
    }

    // Append-only audit trail (trial closures/reopenings, role changes). Anyone signed in can add
    // an entry in their own name; only admins can read; nobody can edit or delete.
    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow create: if request.auth != null &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.action in ['trial_closed', 'trial_reopened', 'role_changed', 'pi_authorized'] &&
        (request.resource.data.action != 'role_changed' || isAdmin()) &&
        request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // Append-only history of PI verifications. Admins read everything; a verified PI reads only
    // their own hospital's history. Written in the same batch as the status flip it records.
    match /piAuthorizations/{id} {
      allow read: if isAdmin() || (isApprovedDoctor() && resource.data.hospitalKey == myHospitalKey());
      allow create: if request.resource.data.id == id &&
        request.resource.data.authorizedByUid == request.auth.uid &&
        ((isAdmin() && request.resource.data.authorizedByRole == 'admin') ||
         (isApprovedDoctor() &&
          request.resource.data.authorizedByRole == 'pi' &&
          request.resource.data.hospitalKey == myHospitalKey() &&
          getAfter(/databases/$(database)/documents/users/$(request.resource.data.piUid)).data.authorizedByUid == request.auth.uid &&
          getAfter(/databases/$(database)/documents/users/$(request.resource.data.piUid)).data.status == 'approved' &&
          getAfter(/databases/$(database)/documents/users/$(request.resource.data.piUid)).data.facility.trim().lower() == myHospitalKey()));
      allow update, delete: if false;
    }

    function myHospitalKey() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.facility.trim().lower();
    }

    // A verified PI may verify a *pending* PI at their own hospital — nothing else. Hospital names
    // must match after trim + lowercase (no cross-hospital approvals), only the status and
    // authorized-by fields may change, and the authorizer must name themselves.
    function isSameHospitalPiAuthorization(data) {
      return isApprovedDoctor() &&
        resource.data.role == 'doctor' &&
        resource.data.status == 'pending' &&
        resource.data.facility is string &&
        myHospitalKey() != '' &&
        resource.data.facility.trim().lower() == myHospitalKey() &&
        data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'authorizedByUid', 'authorizedByName', 'authorizedByRole', 'authorizedAt']) &&
        data.status == 'approved' &&
        data.authorizedByUid == request.auth.uid &&
        data.authorizedByRole == 'pi' &&
        data.authorizedAt == request.time;
    }

    function piMayCloseClaim(claimId) {
      let claimPath = /databases/$(database)/documents/trialClaims/$(claimId);
      let claim = get(claimPath).data;
      let me = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return exists(claimPath) && (
        claim.claimedByUid == request.auth.uid ||
        (claim.hospitalName is string && me.facility is string &&
          claim.hospitalName.lower() == me.facility.lower()) ||
        get(/databases/$(database)/documents/users/$(claim.claimedByUid)).data.doctorUid == request.auth.uid);
    }

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidProfileCreate(uid, data) {
      // Role 'admin' profiles are only created by an admin (allowed via isAdmin() at the call site).
      return request.auth.uid == uid && data.uid == uid &&
        data.email is string && data.name is string &&
        data.role in ['user', 'doctor', 'coordinator'] &&
        ((data.role == 'user' && !('status' in data)) ||
         (data.role == 'doctor' && data.status in ['pending', 'approved'] && data.facility is string) ||
          (data.role == 'coordinator' && data.status == 'pending' &&
           data.requestedDoctorEmail is string &&
           data.facility is string && data.city is string));
    }

    // Owner can edit their own profile, but never grant themselves coordinator/doctor approval and
    // never change their own uid/role.
    function isSelfProfileUpdate(uid, data) {
      return request.auth != null && request.auth.uid == uid &&
        data.uid == uid && data.role == resource.data.role &&
        (data.status != 'approved' || resource.data.status == 'approved') &&
        // A verified PI can't move themselves to another hospital — their hospital decides which
        // PIs they may authorize. Only an admin can change it.
        (resource.data.role != 'doctor' || resource.data.status != 'approved' ||
         data.get('facility', '') == resource.data.get('facility', ''));
    }

    function isDoctor() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'doctor';
    }

    function isApprovedDoctor() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'doctor' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    // A doctor may only flip status/doctorUid on a coordinator profile that named their email —
    // and can only ever set doctorUid to *their own* uid (approved) or null (rejected), never an
    // arbitrary value, so the profile's doctor-link can't be forged to point elsewhere.
    function isDoctorApproval(data) {
      return isApprovedDoctor() &&
        resource.data.role == 'coordinator' &&
        resource.data.requestedDoctorEmail == request.auth.token.email &&
        data.diff(resource.data).affectedKeys().hasOnly(['status', 'doctorUid']) &&
        ((data.status == 'approved' && data.doctorUid == request.auth.uid) ||
         (data.status == 'rejected' && data.doctorUid == null));
    }

    function isApprovedCoordinator() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coordinator' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    function isValidDemandEvent(data) {
      return data.keys().hasOnly(['cond', 'where', 'line', 'met', 'bio', 'resultCount', 'createdAt']) &&
        data.cond is string && data.cond.size() < 200 &&
        data.where is string && data.where.size() < 200 &&
        data.line is string && data.met is string && data.bio is string && data.bio.size() < 200 &&
        data.resultCount is int && data.resultCount >= 0 &&
        data.createdAt == request.time;
    }

    function isValidUsageEvent(data) {
      return data.keys().hasOnly(['type', 'label', 'meta', 'createdAt']) &&
        data.type in ['search', 'browse', 'location', 'click', 'signup', 'signin', 'favorite'] &&
        data.label is string && data.label.size() < 200 &&
        data.meta is string && data.meta.size() < 200 &&
        data.createdAt == request.time;
    }
  }
}
